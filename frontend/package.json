{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter common build",
    "dev": "vite dev",
    "build": "vite build",
    "openapi-types": "pnpm openapi-typescript http://localhost:3000/api/docs-json -o src/shared/api/openapi-schema.d.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "type-check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome format --write .",
    "check": "pnpm type-check && biome check --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/table-core": "^8.21.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24",
    "bits-ui": "^2.17.0",
    "clsx": "^2.1.1",
    "formsnap": "^2.0.1",
    "globals": "^17.4.0",
    "layerchart": "2.0.0-next.48",
    "openapi-typescript": "^7.13.0",
    "phosphor-svelte": "^3.1.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.3.0",
    "@tanstack/svelte-query": "^6.1.13",
    "@tanstack/svelte-query-devtools": "^6.1.13",
    "@xyflow/svelte": "^1.5.2",
    "common": "workspace:*",
    "better-auth": "^1.6.5",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-svelte": "^1.0.1",
    "openapi-fetch": "^0.17.0",
    "runed": "^0.37.1",
    "zod": "^4.3.6"
  }
}
