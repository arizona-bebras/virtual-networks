{
  "name": "common",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "default": "./dist/db/schema.js"
    },
    "./dto/*": {
      "types": "./dist/dto/*.d.ts",
      "default": "./dist/dto/*.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "default": "./dist/schemas/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "description": "",
  "scripts": {
    "prepare": "tsc -p tsconfig.json --incremental false",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome lint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "drizzle-orm": "1.0.0-beta.20",
    "nestjs-zod": "^5.3.0",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11"
  }
}
